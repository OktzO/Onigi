{
  "name": "oktz-curve25519",
  "version": "0.0.7",
  "description": "curve25519-js replacement — XEdDSA sign/verify native Rust, X25519 node:crypto",
  "main": "index.cjs",
  "license": "MIT",
  "files": [
    "index.cjs",
    "native-loader.cjs"
  ],
  "scripts": {
    "build": "napi build --release --platform --js-package-name @oktz/curve25519",
    "build:source": "napi build --release --platform --js-package-name @oktz/curve25519",
    "build:manual": "cargo build --manifest-path Cargo.toml --release",
    "test": "node --test tests/*.test.cjs",
    "docs:verify": "node docs/verify.mjs"
  },
  "optionalDependencies": {
    "@oktz/curve25519-linux-arm64-gnu": "0.0.7",
    "@oktz/curve25519-linux-arm64-musl": "0.0.7",
    "@oktz/curve25519-linux-x64-gnu": "0.0.7",
    "@oktz/curve25519-linux-x64-musl": "0.0.7"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
